# HandyAlliance environment variables (names only — never commit real values).
# Validation: src/lib/env/schema.ts (layered: browser ⊂ platform ⊂ integrations).
# The build fails if the platform scope is only partially configured.
# Naming adapted from spec §33 to the actual stack (lookup keys instead of
# per-price env vars — see docs/HANDYALLIANCE_BILLING_AND_ENTITLEMENTS.md).

NEXT_PUBLIC_APP_URL=

# --- Supabase (platform scope; dedicated HandyAlliance project — NOT BizMetria)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-owned project ref: the admin client derives its origin from this,
# never from the public URL (src/lib/supabase/target.ts).
SUPABASE_PROJECT_REF=
# Set to "preview" only in registered preview environments.
# SUPABASE_TARGET_ENV=

# --- Stripe (integrations scope). Keys are pinned to test mode until the
# owner explicitly sets STRIPE_LIVE_MODE=live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_LIVE_MODE=

# --- Google (Stage 3: Sheets sync §14)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- AI provider (Stage 4+: Estimate Maker §16, Refund Helper §18)
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# --- Messaging (Stage 6: Reviews & Follow-Ups §17)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMS_PROVIDER_API_KEY=
SMS_WEBHOOK_SECRET=

# --- Voice (Stage 8: Call Answering §15, Retell per §00.0.3)
VOICE_PROVIDER_API_KEY=
VOICE_WEBHOOK_SECRET=

# --- Misc
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
APP_ENCRYPTION_KEY=
CRON_SECRET=
