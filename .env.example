# HandyAlliance environment variables (names only — never commit real values).
# The public marketing site currently needs none of these; they are reserved
# for the platform stages (Supabase, Stripe, Google, messaging, voice).

NEXT_PUBLIC_APP_URL=

# Supabase (Stage 1+)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Stage 1/9)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google (Stage 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Analytics
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
