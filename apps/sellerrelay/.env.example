# Public site URL used for canonical URLs, sitemap, and emails.
NEXT_PUBLIC_SITE_URL=https://sellerrelay.com

# Optional public contact email. Omit until the mailbox is working.
NEXT_PUBLIC_CONTACT_EMAIL=

# Google Analytics 4 (optional)
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (optional but recommended before paid traffic)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase service-side integration (required for live form storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET=sellerrelay-private

# Resend (optional; submissions still save without email)
RESEND_API_KEY=
RESEND_FROM=SellerRelay <notifications@sellerrelay.com>
SELLERRELAY_OWNER_EMAIL=quotes@sellerrelay.com

# Real scheduling URL only. Leave blank to hide booking buttons.
NEXT_PUBLIC_BOOKING_URL=

# Local-only acceptance test. Never enable in Vercel production.
SELLERRELAY_DEV_FILE_STORE=0
